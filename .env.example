# =============================================================================
# BotShield Lab — environment variables
# Copy to .env and adjust. Never commit real secrets.
# =============================================================================

# Application
APP_NAME=BotShield Lab
APP_ENV=development
DEBUG=false
API_PREFIX=/api/v1
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Database (SQLite for local development)
DATABASE_URL=sqlite:///./botshield.db

# Rate limiting
RATE_LIMIT_ENABLED=true
RATE_LIMIT_REQUESTS=10
RATE_LIMIT_WINDOW_SECONDS=60
# memory = single process; redis = multi-worker (requires REDIS_URL)
RATE_LIMIT_STORAGE=memory
REDIS_URL=redis://localhost:6379/0

# Bot detection thresholds
DETECTION_WINDOW_SECONDS=60
DETECTION_FREQUENCY_THRESHOLD=8
DETECTION_REPEAT_ENDPOINT_THRESHOLD=5
DETECTION_SUSPICIOUS_SCORE_THRESHOLD=40
DETECTION_HIGH_RISK_SCORE_THRESHOLD=70
DETECTION_CAPTCHA_TRIGGER_SCORE=50

# CAPTCHA — Cloudflare Turnstile
# For local/offline demos use mock (never in production):
CAPTCHA_ENABLED=true
CAPTCHA_PROVIDER=mock
CAPTCHA_MOCK_ENABLED=true
CAPTCHA_MOCK_VALID_TOKEN=mock-valid-token
TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=
TURNSTILE_VERIFY_URL=https://challenges.cloudflare.com/turnstile/v0/siteverify

# Client identity — only trust forwarded headers behind a configured reverse proxy
TRUST_FORWARDED_HEADERS=false
TRUSTED_PROXY_IPS=

# Simulation safety
SIMULATION_MAX_REQUESTS=50
SIMULATION_MIN_INTERVAL_MS=100
SIMULATION_ALLOWED_HOST=127.0.0.1,localhost

# Frontend (optional override when not using Vite proxy)
# VITE_API_BASE_URL=http://127.0.0.1:8000/api/v1
